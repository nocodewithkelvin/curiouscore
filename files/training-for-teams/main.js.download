=>scrollByStep(1));track.addEventListener("scroll",()=>{updateIndicator();updateButtons()},{passive:true});window.addEventListener("resize",()=>{updateIndicator();updateButtons()});updateIndicator();updateButtons()}function initFeatured(section){const featured=section.querySelector("[data-featured]");if(!featured)return;const cards=Array.from(featured.querySelectorAll(".c-testimonials__card"));if(cards.length===0)return;const prevBtn=section.querySelector('[data-direction="prev"]');const nextBtn=section.querySelector('[data-direction="next"]');let index2=0;const setActive=next2=>{index2=(next2%cards.length+cards.length)%cards.length;cards.forEach((c,i2)=>c.classList.toggle("is-active",i2===index2));if(prevBtn)prevBtn.disabled=false;if(nextBtn)nextBtn.disabled=false};cards.forEach((c,i2)=>c.classList.toggle("is-active",i2===0));if(prevBtn)prevBtn.addEventListener("click",()=>setActive(index2-1));if(nextBtn)nextBtn.addEventListener("click",()=>setActive(index2+1));featured.addEventListener("keydown",e2=>{if(e2.key==="ArrowLeft")setActive(index2-1);if(e2.key==="ArrowRight")setActive(index2+1)})}function init2(){document.querySelectorAll(".c-testimonials").forEach(section=>{const layout=section.dataset.layout;if(layout==="carousel")initCarousel(section);else if(layout==="featured")initFeatured(section)})}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init2)}else{init2()}function reduceMotion2(){return window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches}function initCarousel2(section){const track=section.querySelector("[data-track]");if(!track)return;const prevBtn=section.querySelector('[data-direction="prev"]');const nextBtn=section.querySelector('[data-direction="next"]');const indicator=section.querySelector(".c-case-studies__track-indicator");const thumb=section.querySelector(".c-case-studies__track-thumb");const stepFor=()=>{const first=track.querySelector(".c-case-studies__item");if(!first)return 360;const gap=parseFloat(getComputedStyle(track).columnGap||getComputedStyle(track).gap||20)||20;return first.getBoundingClientRect().width+gap};const updateIndicator=()=>{if(!thumb||!indicator)return;const max=Math.max(1,track.scrollWidth-track.clientWidth);const ratio=Math.min(1,Math.max(0,track.scrollLeft/max));const trackW=indicator.clientWidth;const visibleRatio=Math.min(1,track.clientWidth/track.scrollWidth);const thumbW=Math.max(24,Math.round(visibleRatio*trackW));thumb.style.width=`${thumbW}px`;thumb.style.transform=`translateX(${(trackW-thumbW)*ratio}px)`};const updateButtons=()=>{const atStart=track.scrollLeft<=1;const atEnd=track.scrollLeft+track.clientWidth>=track.scrollWidth-1;if(prevBtn)prevBtn.toggleAttribute("disabled",atStart);if(nextBtn)nextBtn.toggleAttribute("disabled",atEnd)};const scrollByStep=direction=>{track.scrollBy({left:direction*stepFor(),behavior:reduceMotion2()?"auto":"smooth"})};if(prevBtn)prevBtn.addEventListener("click",()=>scrollByStep(-1));if(nextBtn)nextBtn.addEventListener("click",()=>scrollByStep(1));track.addEventListener("scroll",()=>{updateIndicator();updateButtons()},{passive:true});window.addEventListener("resize",()=>{updateIndicator();updateButtons()});updateIndicator();updateButtons()}function buildPlayer(type,ref){if(type==="youtube"){const f=document.createElement("iframe");f.src=`https://www.youtube.com/embed/${ref}?rel=0&autoplay=1`;f.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";f.allowFullscreen=true;f.title="Video";return f}if(type==="vimeo"){const f=document.createElement("iframe");f.src=`https://player.vimeo.com/video/${ref}?autoplay=1`;f.allow="autoplay; fullscreen; picture-in-picture";f.allowFullscreen=true;f.title="Video";return f}const v=document.createElement("video");v.src=ref;v.controls=true;v.autoplay=true;v.playsInline=true;return v}function initLightbox(section){const modal=section.querySelector("[data-lightbox]");if(!modal)return;const frame=mod