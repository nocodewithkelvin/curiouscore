tle||"";body2.appendChild(heading);if(course.excerpt){const excerpt=document.createElement("p");excerpt.className="c-course-quiz__card-excerpt";excerpt.textContent=course.excerpt;body2.appendChild(excerpt)}const cta=document.createElement("span");cta.className="c-link c-link--arrow c-course-quiz__card-cta";cta.textContent="View programme";body2.appendChild(cta);card.appendChild(body2);return card}function scoreCourses(courses,selectedTags){return courses.map(course=>{const tags=Array.isArray(course.tags)?course.tags:[];const score=selectedTags.reduce((acc,tag)=>acc+(tags.indexOf(tag)!==-1?1:0),0);return{course,score}}).filter(entry=>entry.score>0).sort((a2,b)=>b.score-a2.score)}function initQuiz(root){const courses=readCourses(root);const maxResults=parseInt(root.dataset.maxResults,10)||3;const intro=root.querySelector("[data-quiz-intro]");const wizard=root.querySelector("[data-quiz-wizard]");const results=root.querySelector("[data-quiz-results]");const cardsWrap=root.querySelector("[data-quiz-cards]");const noMatch=root.querySelector("[data-quiz-no-match]");const stepLabel=root.querySelector("[data-quiz-step]");const progressFill=root.querySelector("[data-quiz-progress-fill]");const questions=Array.from(root.querySelectorAll("[data-quiz-question]"));if(!questions.length)return;let current=0;const chosen=[];let lastResults=[];let swiper=null;const carousel=root.querySelector("[data-quiz-carousel]");const controls=root.querySelector("[data-quiz-controls]");function initCarousel3(){if(!carousel)return;if(swiper){swiper.destroy(true,true);swiper=null}swiper=new core_default(carousel,{modules:[Navigation,Scrollbar],slidesPerView:1.1,spaceBetween:20,watchOverflow:true,a11y:true,navigation:{prevEl:root.querySelector("[data-quiz-prev]"),nextEl:root.querySelector("[data-quiz-next]")},scrollbar:{el:root.querySelector("[data-quiz-scrollbar]"),draggable:true},breakpoints:{768:{slidesPerView:2.2},1200:{slidesPerView:2.5}}});if(controls)controls.hidden=!!swiper.isLocked}const sh