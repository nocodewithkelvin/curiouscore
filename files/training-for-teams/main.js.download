quiz-optin-submit]");const optinMsg=optin&&optin.querySelector("[data-quiz-optin-msg]");const optinDialog=root.querySelector("[data-quiz-optin-dialog]");const optinOpen=root.querySelector("[data-quiz-optin-open]");const optinClose=root.querySelector("[data-quiz-optin-close]");function openDialog(){if(!optinDialog)return;resetOptin();if(typeof optinDialog.showModal==="function"){optinDialog.showModal()}else{optinDialog.setAttribute("open","")}if(optinEmail)optinEmail.focus()}function closeDialog(){if(!optinDialog)return;if(typeof optinDialog.close==="function"){optinDialog.close()}else{optinDialog.removeAttribute("open")}}if(optinOpen)optinOpen.addEventListener("click",openDialog);if(optinClose)optinClose.addEventListener("click",closeDialog);if(optinDialog){optinDialog.addEventListener("click",e2=>{if(e2.target===optinDialog)closeDialog()})}function showOptinMsg(text2,isError){if(!optinMsg)return;optinMsg.textContent=text2;optinMsg.hidden=false;optinMsg.classList.toggle("is-error",!!isError);optinMsg.classList.toggle("is-success",!isError)}function resetOptin(){if(!optin)return;if(optinForm)optinForm.hidden=false;if(optinMsg){optinMsg.hidden=true;optinMsg.textContent="";optinMsg.classList.remove("is-error","is-success")}if(optinEmail)optinEmail.value="";if(optinBtn)optinBtn.disabled=false}if(optinForm){optinForm.addEventListener("submit",e2=>{e2.preventDefault();const globals=window.sod_globals||{};const email=(optinEmail&&optinEmail.value||"").trim();if(!email||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){showOptinMsg("Please enter a valid email address.",true);if(optinEmail)optinEmail.focus();return}if(!globals.ajax_url){showOptinMsg("Sorry, something went wrong. Please try again later.",true);return}if(optinBtn)optinBtn.disabled=true;showOptinMsg("Sending\u2026",false);const body2=new URLSearchParams;body2.append("action","course_quiz_results");body2.append("nonce",globals.nonce||"");body2.append("email",email);body2.append("results",JSON.stringify(lastResults));body2.append("quiz_title",root.dataset.quizTitle||"");body2.append("page_url",window.location.href);fetch(globals.ajax_url,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:body2.toString()}).then(r2=>r2.json()).then(res=>{if(res&&res.success){const done=optin&&optin.dataset.success||"Done \u2014 check your inbox.";if(optinForm)optinForm.hidden=true;showOptinMsg(done,false)}else{const m=res&&res.data&&res.data.message||"Sorry, that didn\u2019t work. Please try again.";showOptinMsg(m,true);if(optinBtn)optinBtn.disabled=false}}).catch(()=>{showOptinMsg("Sorry, that didn\u2019t work. Please try again.",true);if(optinBtn)optinBtn.disabled=false})})}}function init5(){document.querySelectorAll("[data-course-quiz]").forEach(initQuiz)}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init5)}else{init5()}function pad(n2){return String(n2).padStart(2,"0")}function initCountdown(root){const iso=root.dataset.datetime;if(!iso)return;const target=Date.parse(iso);if(Number.isNaN(target))return;const fields={days:root.querySelector('[data-cd="days"]'),hours:root.querySelector('[data-cd="hours"]'),minutes:root.querySelector('[data-cd="minutes"]'),seconds:root.querySelector('[data-cd="seconds"]')};const countdown=root.querySelector("[data-countdown]");const live=root.querySelector("[data-countdown-live]");if(!fields.days)return;let timer=null;const tick=()=>{const diff=target-Date.now();if(diff<=0){if(countdown)countdown.hidden=true;if(live)live.hidden=false;if(timer)clearInterval(timer);return}const secs=Math.floor(diff/1e3);fields.days.textContent=pad(Math.floor(secs/86400));fields.hours.textContent=pad(Math.floor(secs%86400/3600));fields.minutes.textContent=pad(Math.floor(secs%3600/60));fields.seconds.textContent=pad(secs%60)};tick();timer=setInterval(tick,1e3)}function initDismiss(root){const btn=root.querySelector("[data-webinar-dismiss]");if(!btn)return;btn.addEventListener("click",()=>{root.remove();document.body.classList.remove("has-webinar-sticky-top","has-webinar-sticky-bottom")})}function buildPlayer3(type,ref){if(type==="youtube"){const f=document.createElement("iframe");f.src=`https://www.youtube.com/embed/${ref}?rel=0&autoplay=1`;f.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";f.allowFullscreen=true;f.title="Video";return f}if(type==="vimeo"){const f=document.createElement("iframe");f.src=`https://player.vimeo.com/video/${ref}?autoplay=1`;f.allow="autoplay; fullscreen; picture-in-picture";f.allowFullscreen=true;f.title="Video";return f}const v=document.createElement("video");v.src=ref;v.controls=true;v.autoplay=true;v.playsInline=true;return v}function initLightbox3(root){const modal=root.querySelector("[data-lightbox]");if(!modal)return;const frame=modal.querySelector("[data-lightbox-frame]");let lastFocused=null;const open=(type,ref,trigger2)=>{lastFocused=trigger2||document.activeElement;frame.innerHTML="";frame.appendChild(buildPlayer3(type,ref));modal.hidden=false;document.body.style.overflow="hidden";const closeBtn=modal.querySelector("[data-lightbox-close]");if(closeBtn)closeBtn.focus()};const close=()=>{modal.hidden=true;frame.innerHTML="";document.body.style.overflow="";if(lastFocused&&typeof lastFocused.focus==="function")lastFocused.focus()};root.querySelectorAll("[data-play]").forEach(btn=>{btn.addEventListener("click",()=>open(btn.dataset.videoType,btn.dataset.videoRef,btn))});modal.querySelectorAll("[data-lightbox-close]").forEach(el=>el.addEventListener("click",close));document.addEventListener("keydown",e2=>{if(e2.key==="Escape"&&!modal.hidden)close()})}function init6(){document.querySelectorAll("[data-webinar-callout]").forEach(root=>{initCountdown(root);initDismiss(root);initLightbox3(root)})}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init6)}else{init6()}function initCalc(root){const cfgNode=root.querySelector("[data-cfc-config]");if(!cfgNode)return;let cfg;try{cfg=JSON.parse(cfgNode.textContent||"{}")}catch(e2){return}const R=cfg.rates||{};const SHOW=cfg.show||{};const currency=cfg.currency||"S$";const courseSelect=root.querySelector("[data-cfc-course]");const feeInput=root.querySelector("[data-cfc-fee]");const ageInput=root.querySelector("[data-cfc-age]");const ntuc=root.querySelector("[data-cfc-ntuc]");const sfcToggle=root.querySelector("[data-cfc-sfc]");const sfcAmt=root.querySelector("[data-cfc-sfc-amt]");const pseaToggle=root.querySelector("[data-cfc-psea]");const pseaAmt=root.querySelector("[data-cfc-psea-amt]");const resetBtn=root.querySelector("[data-cfc-reset]");const out=k=>root.querySelector(`[data-cfc-out="${k}"]`);const row=k=>root.querySelector(`[data-cfc-row="${k}"]`);const label=k=>root.querySelector(`[data-cfc-label="${k}"]`);const group=k=>root.querySelector(`[data-cfc-show="${k}"]`);const radio=name=>{const el=root.querySelector(`input[name="cfc-${name}"]:checked`);return el?el.value:""};const num=el=>{const v=parseFloat(el&&el.value);return Number.isNaN(v)||v<0?0:v};const money=n2=>currency+n2.toLocaleString(void 0,{minimumFractionDigits:2,maximumFractionDigits:2});const toggle=(el,show)=>{if(el)el.hidden=!show};function renumberSteps(){let n2=0;["subsidy","sfc","psea","utap"].forEach(k=>{const r2=row(k);if(!r2||r2.hidden)return;n2+=1;const chip=r2.querySelector(".c-cfc__step");if(chip)chip.textContent=`Step ${n2}`})}function recalc(){const fee=courseSelect?num(courseSelect):num(feeInput);const citizenship=radio("citizenship");const age=num(ageInput);const isLocal=citizenship==="sc"||citizenship==="pr";const isCitizen=citizenship==="sc";const isSenior=age>=(R.mcesAge||40);toggle(group("age"),isLocal);toggle(group("utap"),isLocal);toggle(group("sfc"),isCitizen&&age>=25);toggle(group("psea"),isCitizen);toggle(group("sfc-amt"),!!(sfcToggle&&sfcToggle.checked));toggle(group("psea-amt"),!!(pseaToggle&&pseaToggle.checked));let pct=0;if(citizenship==="pr")pct=R.baseline;if(citizenship==="sc")pct=isSenior&&R.mces>R.baseline?R.mces:R.baseline;const gst=fee*R.gst/100;const full=fee+gst;const subsidy=fee*pct/100;let payable=Math.max(0,full-subsidy);let sfc=0;if(SHOW.sfc&&sfcToggle&&sfcToggle.checked&&isCitizen&&age>=25){sfc=Math.min(num(sfcAmt),payable);payable-=sfc}let psea=0;if(SHOW.psea&&pseaToggle&&pseaToggle.checked&&isCitizen){psea=Math.min(num(pseaAmt),payable);payable-=psea}let utap=0;if(SHOW.utap&&ntuc&&ntuc.checked&&isLocal){const cap=isSenior?R.utapCapSenior:R.utapCap;utap=Math.min(payable*R.utapPct/100,cap);payable=Math.max(0,payable-utap)}const saved=subsidy+utap;out("fee").textContent=money(fee);toggle(row("subsidy"),subsidy>0);if(subsidy>0){label("subsidy").textContent=`SSG Subsidy Applied (${Math.round(pct)}% OFF)`;out("subsidy").textContent="- "+money(subsidy)}toggle(row("sfc"),sfc>0);if(sfc>0)out("sfc").textContent="- "+money(sfc);toggle(row("psea"),psea>0);if(psea>0)out("psea").textContent="- "+money(psea);toggle(row("utap"),utap>0);if(utap>0){const cap=isSenior?R.utapCapSenior:R.utapCap;label("utap").textContent=`UTAP (NTUC) Claim (up to ${currency}${cap})`;out("utap").textContent="- "+money(utap)}renumberSteps();out("nett").textContent=money(payable);toggle(row("save"),saved>0);if(saved>0)out("save").textContent=money(saved);updateEnquire({fee,subsidy,gst,nett:payable})}function updateEnquire(d){const a2=root.querySelector("[data-cfc-enquire]");if(!a2)return;const base=a2.getAttribute("data-cfc-base")||a2.getAttribute("href")||"";const params=new URLSearchParams({gross_fee:Math.round(d.fee),subsidy:Math.round(d.subsidy),gst:Math.round(d.gst),nett_fee:Math.round(d.nett)});if(courseSelect){const opt=courseSelect.options[courseSelect.selectedIndex];if(opt)params.set("course",opt.textContent.trim())}a2.setAttribute("href",base+(base.indexOf("?")>-1?"&":"?")+params.toString())}function reset(){if(courseSelect)courseSelect.selectedIndex=0;if(feeInput)feeInput.value=feeInput.defaultValue;if(ageInput)ageInput.value=ageInput.defaultValue;if(ntuc)ntuc.checked=false;if(sfcToggle)sfcToggle.checked=false;if(sfcAmt)sfcAmt.value=sfcAmt.defaultValue;if(pseaToggle)pseaToggle.checked=false;if(pseaAmt)pseaAmt.value=pseaAmt.defaultValue;const sc=root.querySelector('input[name="cfc-citizenship"][value="sc"]');if(sc)sc.checked=true;recalc()}root.addEventListener("input",recalc);root.addEventListener("change",recalc);if(resetBtn)resetBtn.addEventListener("click",reset);recalc()}function init7(){document.querySelectorAll("[data-cfc]").forEach(initCalc)}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init7)}else{init7()}})();
